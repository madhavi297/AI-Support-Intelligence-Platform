# ==========================================================
# AI Support Intelligence Platform - Environment Variables
# ==========================================================

# Application Settings
APP_NAME=AI Support Intelligence Platform
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# Database Settings (SQLite local file)
DATABASE_URL=sqlite:///./support_intelligence.db

# LLM Provider Configuration
# Set LLM_PROVIDER to "mock" for guaranteed offline demonstration (no API key needed).
# Set LLM_PROVIDER to "openai" or "gemini" if an active API key is provided.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# Knowledge Retrieval / RAG Configuration
# "tfidf" allows zero-overhead semantic vector search without needing large neural weights.
EMBEDDING_MODE=tfidf
SIMILARITY_THRESHOLD=0.1
TOP_K_RETRIEVAL=3
